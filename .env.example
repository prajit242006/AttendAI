# Copy this file to .env and fill in your own values.
# The .env file is ignored by git and must never be committed.

SECRET_KEY=change-this-secret-key

# MySQL connection string.
# Replace YOUR_MYSQL_PASSWORD with your own MySQL root password.
# If your password contains @ : / characters, URL-encode them (@ -> %40).
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost/attendai_db

FLASK_ENV=development

# --- Face recognition tuning -----------------------------------------
# LBPH distance: LOWER is a better match. Accept a prediction only when
# the distance is below this number. Raise it if students are not being
# recognised, lower it if strangers are being recognised.
RECOGNITION_THRESHOLD=70
MIN_FACE_SAMPLES=5
FACE_SAMPLES_TARGET=15

# --- Attendance rules -------------------------------------------------
DEFAULT_LATE_THRESHOLD_MIN=10
DEFAULT_PRESENCE_THRESHOLD=75
DEFAULT_CHECK_INTERVAL_SEC=10
MIN_ATTENDANCE_PERCENT=75

# --- Basic liveness check --------------------------------------------
LIVENESS_ENABLED=true
LIVENESS_MOVE_RATIO=0.18
LIVENESS_SCALE_RATIO=1.15
LIVENESS_TIMEOUT_SEC=25
